# Copie este arquivo para .env e preencha os valores.
# NUNCA versione o .env (ele já está no .gitignore).

APP_ENV=dev
FLASK_APP=app.py
SECRET_KEY=gere-uma-chave-com-python-c-"import secrets; print(secrets.token_hex(32))"

# Supabase > Connect > Session pooler (porta 5432)
DATABASE_URL=postgresql://postgres.SEU_PROJETO:SUA_SENHA@aws-0-sa-east-1.pooler.supabase.com:5432/postgres
# Opcional: banco separado para os testes. Se vazio, os testes usam o DATABASE_URL
# num schema isolado chamado "testes", que é criado e apagado automaticamente.
TEST_DATABASE_URL=

# Supabase > Project Settings > API (fotos no Storage)
SUPABASE_URL=https://SEU_PROJETO.supabase.co
SUPABASE_SERVICE_KEY=
SUPABASE_BUCKET=fotos

NOMINATIM_USER_AGENT=AchaPet/1.0 (seu-email@exemplo.com)
LOG_LEVEL=INFO
