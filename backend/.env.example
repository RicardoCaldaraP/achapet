# Copie para .env e preencha. NUNCA versione o .env.
NODE_ENV=development
PORT=3001
LOG_LEVEL=info

# Supabase > Connect > Session pooler (troque [YOUR-PASSWORD] pela senha do banco)
DATABASE_URL=postgresql://postgres.SEU_PROJETO:SENHA@aws-1-sa-east-1.pooler.supabase.com:5432/postgres
# Opcional: banco para os testes (se vazio, usa o DATABASE_URL num schema "testes" isolado)
TEST_DATABASE_URL=

# Supabase > Project Settings > API Keys
SUPABASE_URL=https://SEU_PROJETO.supabase.co
SUPABASE_SECRET_KEY=sb_secret_...

# Endereços do site que podem chamar a API (separados por vírgula)
CORS_ORIGIN=http://localhost:5173
NOMINATIM_USER_AGENT=AchaPet/1.0 (projeto academico UVV)

# Endereço público do site (links dos e-mails). Na Netlify pode ficar vazio: usa a variável URL.
SITE_URL=http://localhost:5173

# Alertas por e-mail (opcional). Sem isso, os alertas só aparecem no log.
# Gmail grátis: ative a verificação em 2 etapas e crie uma "senha de app" em
# https://myaccount.google.com/apppasswords (até 500 e-mails por dia).
SMTP_HOST=smtp.gmail.com
SMTP_PORTA=587
SMTP_USUARIO=
SMTP_SENHA=
EMAIL_REMETENTE=AchaPet <seu.email@gmail.com>
